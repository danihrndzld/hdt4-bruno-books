meta {
  name: List books filtered by author
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/books?author=wilson
  body: none
  auth: none
}

params:query {
  author: wilson
}

assert {
  res.status: eq 200
}

tests {
  test("the filter narrows the list to one author", function() {
    const body = res.getBody();
    expect(body.length).to.equal(1);
    expect(body[0].author).to.contain("Wilson");
  });
}
